{
  "name": "cable-a-tierra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start",
    "test:emu": "firebase emulators:exec --only auth,firestore \"vitest run --project emulator\"",
    "test:all": "npm test && npm run test:emu && npm run test:e2e",
    "test:e2e": "firebase emulators:exec --only auth,firestore \"playwright test\""
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.33.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
