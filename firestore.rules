rules_version = '2';

// Todas las escrituras pasan por el servidor (Admin SDK, que ignora estas reglas),
// así que acá nunca se permite escribir (RNF-01). Solo se habilitan lecturas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Datos públicos de la organización: cualquiera los ve, incluso invitados (RF-16a).
    match /organizations/{organizationId} {
      allow read: if true;

      // Apodo y estadísticas: públicos (RF-13, RF-04d).
      match /players/{playerId} {
        allow read: if true;
      }

      // Partidos: los ve cualquiera, incluso invitados (RF-12a).
      match /matches/{matchId} {
        allow read: if true;
      }

      // Nombre y fecha de nacimiento: solo miembros, es decir, el admin y las
      // cuentas asociadas a un jugador/a de la organización (RF-04c, RF-04d).
      match /playersPrivate/{playerId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/organizations/$(organizationId)).data.memberUids;
      }
    }
  }
}
