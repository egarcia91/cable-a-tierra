# Copiar a .env.local. Los valores de abajo ya funcionan en local con los emuladores.
# En Vercel se cargan los valores reales del proyecto de Firebase.

# Firebase cliente (públicas, viajan al navegador)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-cable-a-tierra.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cable-a-tierra
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# true en local: conecta cliente y Admin SDK a los emuladores (Auth 9099, Firestore 8080)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Firebase Admin SDK (secretas, solo servidor). Vacías en local: los emuladores no las piden.
FIREBASE_PROJECT_ID=demo-cable-a-tierra
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
